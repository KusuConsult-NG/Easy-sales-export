# Dependencies (installed fresh in Docker)
node_modules
npm-debug.log*

# Build output (built inside Docker)
.next

# Environment files (injected by Railway at runtime)
.env
.env.*
!.env.example

# Git
.git
.gitignore

# Dev / local tooling
.node-version
.npmrc
*.md
*.test.*
__tests__
coverage
.nyc_output

# Large directories not needed to build the app. These were being copied into
# the build context, inflating the image and the builder's working set.
artifacts
screenshots
exports
e2e
tests
docs
scripts
.turbo
playwright-report
test-results

# Misc
.DS_Store
*.log
Thumbs.db
