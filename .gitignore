# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase service account (NEVER commit)
service-account*.json
.env*.local

# Scripts data (prevent committing json/csv with real user PII)
scripts/data/*.json
scripts/data/*.csv
*.csv

# Scratch and test output
/scratch/
/test-results/
/firestore-debug.log
/playwright-report/


.env.staging

# Generated by scripts/build-deploy-sql.mjs — regenerate, never commit
deploy.sql

# Personal data must never be committed. exports/ held all_users.xlsx —
# 41,105 records with name, email and phone — in a public repository.
# See docs/audit/pii-exposure-2026-08-11.md.
exports/
*.xlsx
*.csv

# Turborepo build cache. 66 files were tracked; caches can contain compiled
# output and environment values and have no business in version control.
.turbo/

# Local stack (scripts/local-stack/up.sh)
# The Postgres data directory, the fetched PostgREST binary, the generated JWT
# secret and the service logs. All machine-local; none of it belongs in git.
.local-stack/
public/uploads/local/

# Playwright persona sessions, written by e2e/global-setup.ts.
# Real signed-in cookies for the seeded local identities — machine-local, and
# regenerated on every run.
.auth/
