#!/usr/bin/env sh
# Easy Sales Export — pre-push hook
# Runs the Jest unit suite before any push to remote.
#
# The full `tsc --noEmit` that used to run here first has been removed. It was
# the third type-check of the same tree:
#
#   .husky/pre-commit   tsc over the whole project, on every commit that stages
#                       a .ts or .tsx file
#   here                tsc over the whole project again
#   CI                  tsc, lint, build and this same suite, on every pull
#                       request to main and on main itself
#
# WHAT STILL GUARANTEES IT
#
# Nothing type-broken can reach main: CI runs `npx tsc --noEmit` on every PR and
# on main, and main takes changes by PR. That is the guarantee, and it did not
# come from this hook.
#
# WHAT IS ACTUALLY LOST
#
# Local feedback on the case pre-commit cannot see. A commit that stages no
# TypeScript does not run tsc — and, more to the point, git does not run
# pre-commit for a merge commit at all, so merging two individually clean
# branches into a broken tree is exactly the case this hook used to catch at
# push time. CI still catches it, a couple of minutes later, on the PR.
#
# The unit suite is kept because it is fast (about 15 seconds for ~1,600 tests)
# and because a failing test is worth knowing about before it is on the remote,
# where it is somebody else's problem too.
#
# WHAT NEITHER THIS HOOK NOR THE SUITE CAN SEE — #382
#
# Jest resolves modules; it never bundles and never applies the server-action
# transform. So a client component importing a server-only module, and a
# "use server" module exporting a value, both pass every test and both stop
# `next build` dead. Three of those shipped to this branch before anyone ran a
# build. CI does run one — but only on pull requests to main and on main, so a
# long-lived branch with no PR open is unchecked.
#
# The build is NOT added here: it takes minutes, and a push-time gate that slow
# gets bypassed. Two things cover it instead:
#
#   npm run verify                          typecheck, lint, build, tests — run
#                                           it before pushing a branch that has
#                                           no PR open yet.
#   the-app-can-still-be-built.test.ts      catches both of the shapes that
#                                           actually broke it, in seconds, and
#                                           does run here.
#
# WHAT THIS HOOK DID NOT RUN, AND WHAT THAT COST — #672
#
# CI runs TWO Jest suites: the unit run below, and `npm run test:pg` (the
# money SQL — concurrency, row locks, wallet debits, claim_status_transition).
# This hook ran the first. So a red pg suite is invisible at push time, and it
# was: SEVEN consecutive pushes went to main with CI failing, every one of them
# on the same single test, and each push printed "✅ Unit tests passed" on the
# way out.
#
# It runs both now — but only when a database is actually reachable, because a
# push-time gate that fails on a laptop with no cluster gets bypassed, and a
# bypassed gate protects nothing. When there is no database it says so, in the
# one place the person pushing is already looking, rather than staying silent
# and letting "tests passed" mean less than it appears to.

echo "🧪 Running Jest unit tests..."
TZ=UTC npm run test
if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed. Fix them before pushing."
  exit 1
fi
echo "✅ Unit tests passed — push proceeding."

# The stack writes LOCAL_PG_URL into .env.development.local (#672); an explicit
# environment variable still wins, which is what CI relies on.
PG_URL="$LOCAL_PG_URL"
if [ -z "$PG_URL" ] && [ -f .env.development.local ]; then
  PG_URL=$(grep -E '^[[:space:]]*LOCAL_PG_URL[[:space:]]*=' .env.development.local | tail -n 1 | cut -d= -f2- | tr -d '"'"'"' ')
fi

if [ -n "$PG_URL" ]; then
  echo "🗄  Running the database suite (money SQL)..."
  LOCAL_PG_URL="$PG_URL" npm run test:pg
  if [ $? -ne 0 ]; then
    echo "❌ Database tests failed. Fix them before pushing — CI runs this same suite."
    exit 1
  fi
  echo "✅ Database tests passed — push proceeding."
else
  echo "⚠️  NO DATABASE SUITE RUN. The money SQL (locks, wallet debits, claim"
  echo "   transitions) was NOT checked — CI will run it and can still go red."
  echo "   To check it here first: ./scripts/local-stack/up.sh"
fi
