# e2e and scripts are NOT excluded — #402. This file runs BEFORE .dockerignore:
# the Railway CLI uploads the directory, and whatever it drops here never
# reaches the Docker build context at all. The builder's `npx tsc --noEmit`
# compiles src/scripts/*.ts, playwright.config.ts and src/__tests__/**, all of
# which import from those two directories, so removing them fails the build with
# thirteen TS2307s before a single type is checked. See .dockerignore for the
# full account. Do not re-add them while tsconfig compiles them.

*.txt
*.py
*.json
!**/package.json
!package-lock.json
!**/tsconfig.json
!railway.json
!firebase.json
!firestore.indexes.json
!sentry.client.config.ts
!sentry.edge.config.ts
!sentry.server.config.ts

# Environment files must never leave this machine. .dockerignore already keeps
# them out of the build context, so the image was never at risk — but the CLI
# uploads the directory before Docker sees it, and there is no reason for local
# secrets to reach a build server at all.
.env
.env.*
!.env.example
