# Exclude build cache — this is the #1 cause of "Deploying outputs" failures
# The cache is 1.3GB and must not be uploaded to Vercel's CDN
.next/cache

# Local dev artifacts
.env.local
.env.*.local

# Test files
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage

# Scripts (server-side maintenance scripts, not needed in prod)
scripts

# Backup files
*.bak
src/app/actions/*.bak

# IDE
.vscode
.idea
