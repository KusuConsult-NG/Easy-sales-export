rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // HELPER FUNCTIONS
    // ============================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      let userRoles = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             ('admin' in userRoles || 'super_admin' in userRoles);
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isVerified() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verified == true;
    }

    // NEW: Scoped membership guard using the root users document
    function isApprovedFor(module) {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let reg = user.data.serviceRegistrations[module];
      return reg != null && (reg.status == "approved" || reg.status == "active" || reg.status == "paid");
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) &&
                       request.resource.data.keys().hasAll(['email', 'fullName', 'roles']) &&
                       request.resource.data.roles.hasOnly(['user']);
      
      // EXPANDED: users can update their own profile including KYC identity fields
      allow update: if isOwner(userId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         // Core profile fields written by updateUserProfileAction
                         'firstName', 'lastName', 'otherName', 'fullName',
                         'phone', 'address', 'location', 'bio', 'businessType', 'updatedAt',
                         // KYC / Identity fields (collected or live-verified)
                         'nin', 'ninVerified', 'votersCardNumber',
                         'bvn', 'bvnVerified', 'idType', 'idNumber', 'idVerified',
                         // Nested KYC map (written by live QoreID server actions)
                         'kyc',
                         // Bank details
                         'bankDetails', 'bankAccountNumber', 'bankAccountName', 'bankCode',
                         // Notification preferences
                         'notifications', 'marketingOptIn',
                         // Onboarding
                         'onboardingCompleted'
                       ])
                    || isAdmin();
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // WAVE APPLICATIONS
    // ============================================
    match /wave_applications/{applicationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Create: authenticated, owns record, required fields present, starts as pending
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       // Section A: Personal (required core fields)
                       request.resource.data.keys().hasAll([
                         'surname', 'firstName', 'dateOfBirth', 'phone',
                         'stateOfResidence', 'lgaOfResidence',
                         // Section B: Identity (required)
                         'nin', 'votersCardNumber',
                         // Section E: Financial (required)
                         'bankName', 'accountNumber', 'bvn',
                         // Declaration
                         'declarationAccepted', 'consentGiven'
                       ]) &&
                       request.resource.data.declarationAccepted == true &&
                       request.resource.data.consentGiven == true;
      
      // Update: Admin only (approval/rejection/review)
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'reviewedBy', 'reviewedAt', 'rejectionReason',
                         'reviewNotes', 'updatedAt',
                         // Standardized approval fields
                         'approvedBy', 'approvalTimestamp', 'approvalNote',
                         'rejectedBy', 'rejectedAt'
                       ]);
      
      allow delete: if isAdmin();
    }

    
    // ============================================
    // COOPERATIVE MEMBERSHIPS
    // ============================================
    match /cooperative_memberships/{membershipId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.totalContributions >= 0;
      
      allow update: if isAdmin() || 
                       (isOwner(resource.data.userId) && 
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'totalContributions', 'tier', 'updatedAt'
                        ]));
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // COOPERATIVE MEMBERS (main collection used by app)
    // ============================================
    match /cooperative_members/{memberId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid;
      
      allow update: if isAdmin() ||
                       (isOwner(resource.data.userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'totalContributions', 'contributionAmount', 'savingsBalance',
                          'tier', 'status', 'updatedAt'
                        ]));
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // COOPERATIVE ONBOARDING APPLICATIONS
    // ============================================
    match /cooperative_onboarding_applications/{applicationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid;
      
      allow update: if isAdmin() ||
                       // Allow owner to update while status is 'draft' only
                       (isOwner(resource.data.userId) &&
                        resource.data.status == 'draft');
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // COOPERATIVE CONTRIBUTIONS
    // ============================================
    match /cooperative_contributions/{contributionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.amount > 0 &&
                       request.resource.data.status == 'pending';
      
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // COOPERATIVE TRANSACTIONS
    // ============================================
    match /cooperative_transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // FIXED SAVINGS PLANS
    // ============================================
    match /fixed_savings_plans/{planId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.amount > 0;
      
      allow update: if isAdmin() ||
                       (isOwner(resource.data.userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status', 'updatedAt'
                        ]));
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // LOAN APPLICATIONS
    // ============================================
    match /loan_applications/{loanId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.amount > 0 &&
                       request.resource.data.status == 'pending';
      
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'reviewedBy', 'reviewedAt', 'rejectionReason',
                         'disbursedAt', 'disbursed', 'disbursementNote',
                         'disbursementTransferCode', 'pendingManualDisbursement',
                         'approvalChain', 'updatedAt',
                         // Standardized approval fields
                         'approvedBy', 'approvedAt', 'approvalTimestamp',
                         'rejectedBy', 'rejectedAt'
                       ]);
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // WITHDRAWALS (Cooperative)
    // ============================================
    match /withdrawals/{withdrawalId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.amount > 0 &&
                       request.resource.data.status == 'pending';
      
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'processedBy', 'processedAt', 'adminNotes', 'updatedAt'
                       ]);
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // WAVE EARNINGS WITHDRAWALS (new collection)
    // ============================================
    match /wave_withdrawals/{withdrawalId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.amount >= 5000 &&
                       request.resource.data.status == 'pending';
      
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'status', 'processedBy', 'processedAt', 'adminNotes',
                         'transactionReference', 'updatedAt'
                       ]);
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // WAVE TRAINING REGISTRATIONS
    // ============================================
    match /wave_training_registrations/{registrationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid;
      
      // Admin can mark attendance
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'attended', 'attendedAt', 'updatedAt'
                       ]);
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // KYC VERIFICATIONS
    // ============================================
    match /kyc_verifications/{verificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Only server-side (Admin SDK) should create these
      // Client-side creation blocked for security
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // BRIEFING SUBMISSIONS (offline WAVE field submissions)
    // ============================================
    match /briefing_submissions/{submissionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid;
      
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // PLATFORM SETTINGS (admin-managed global config)
    // ============================================
    match /platform_settings/{settingId} {
      // All authenticated users can READ platform settings (feature flags, etc.)
      allow read: if isSignedIn();
      
      // Only admin can write
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // LAND LISTINGS
    // ============================================
    match /land_listings/{listingId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.price > 0;
      
      allow update: if (isOwner(resource.data.userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'title', 'description', 'price', 'updatedAt'
                        ]))
                    || isAdmin();
      
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ============================================
    // AUDIT LOGS (immutable)
    // ============================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }
    
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if false;
    }
    
    // ============================================
    // ANNOUNCEMENTS & BANNERS
    // ============================================
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // EXPORT MODULE
    // ============================================
    match /export_orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      allow create: if isVerified() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending';
      
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /export_participants/{participantId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /export_windows/{windowId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Export Catalog (products shown to buyers)
    match /export_catalog/{itemId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Export Investments (user slots)
    match /export_investments/{investmentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Export Onboarding Applications
    match /export_onboarding_applications/{applicationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // ACADEMY MODULE
    // ============================================
    match /academy_courses/{courseId} {
      allow read: if isApprovedFor('academy') || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /course_enrollments/{enrollmentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }
    
    match /certificates/{certificateId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /wave_certificates/{certId} {
      allow read: if isOwner(resource.data.memberId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // CONVERSATIONS & MESSAGES
    // ============================================
    match /conversations/{conversationId} {
      // Participants can read their own conversations; admins can read ALL (for support inbox)
      allow read: if (isSignedIn() && request.auth.uid in resource.data.participants)
                  || isAdmin();
      
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() >= 2;
      
      // Participants can update (e.g. lastRead); admins can update any conversation
      allow update: if (isSignedIn() && request.auth.uid in resource.data.participants)
                    || isAdmin();
      
      allow delete: if false;
      
      match /messages/{messageId} {
        // Participants can read; admins can read all messages for support
        allow read: if (isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants)
          || isAdmin();
        
        // Participants send messages with their own senderId; admins can also send (replies)
        allow create: if isSignedIn() &&
          (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
           || isAdmin()) &&
          request.resource.data.senderId == request.auth.uid;
        
        allow update: if false;
        allow delete: if false;
      }
    }
    
    // ============================================
    // MARKETPLACE MODULE
    // ============================================
    match /marketplace_sellers/{sellerId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending';
      
      allow update: if (isOwner(resource.data.userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'businessName', 'description', 'phone', 'address', 'updatedAt'
                        ]))
                    || isAdmin();
      
      allow delete: if isAdmin();
    }
    
    match /marketplace_products/{productId} {
      allow read: if isSignedIn();
      
      // Sellers can create products if their serviceRegistrations.marketplace shows approved status
      allow create: if isSignedIn() &&
                       request.resource.data.sellerId == request.auth.uid &&
                       request.resource.data.price > 0 &&
                       request.resource.data.stock >= 0 &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.serviceRegistrations.marketplace.status == 'approved';
      
      allow update: if isOwner(resource.data.sellerId) || isAdmin();
      allow delete: if isOwner(resource.data.sellerId) || isAdmin();
    }
    
    match /marketplace_orders/{orderId} {
      allow read: if isSignedIn() &&
                     (resource.data.buyerId == request.auth.uid ||
                      resource.data.sellerId == request.auth.uid ||
                      isAdmin());
      
      allow create: if isSignedIn() &&
                       request.resource.data.buyerId == request.auth.uid &&
                       request.resource.data.status == 'pending';
      
      allow update: if isAdmin() ||
                       (isOwner(resource.data.sellerId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                       (isOwner(resource.data.buyerId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryAddress', 'updatedAt']));
      
      allow delete: if isAdmin();
    }
    
    // Seller Verifications
    match /seller_verifications/{verificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // WAVE MODULE
    // ============================================
    match /wave_members/{memberId} {
      allow read: if isApprovedFor('wave') || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                       (isOwner(resource.data.userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'progressTracking', 'updatedAt'
                        ]));
      allow delete: if isAdmin();
    }
    
    match /wave_resources/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                       // Allow incrementing downloads
                       (isSignedIn() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']));
      allow delete: if isAdmin();
    }
    
    match /wave_training_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() ||
                       // Allow incrementing participant count during registration
                       (isSignedIn() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentParticipants']));
      allow delete: if isAdmin();
    }
    
    match /wave_shipments/{shipmentId} {
      allow read: if isOwner(resource.data.memberId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /wave_earnings/{earningId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // FARM NATION MODULE
    // ============================================
    match /farm_nation_properties/{propertyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    match /farm_nation_inquiries/{inquiryId} {
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid ||
                      resource.data.propertyOwnerId == request.auth.uid ||
                      isAdmin());
      
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      allow update: if isAdmin() ||
                       (isOwner(resource.data.propertyOwnerId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status', 'response', 'updatedAt'
                        ]));
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // NOTIFICATIONS
    // ============================================
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAdmin();
      allow update: if (isOwner(resource.data.userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']))
                    || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ============================================
    // TESTIMONIALS
    // ============================================
    match /testimonials/{testimonialId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
    
    // ============================================
    // ESCROW TRANSACTIONS
    // ============================================
    match /escrow_transactions/{transactionId} {
      allow read: if isSignedIn() && 
                     (resource.data.buyerId == request.auth.uid ||
                      resource.data.sellerId == request.auth.uid ||
                      isAdmin());
      
      allow create: if isSignedIn() &&
                       (request.resource.data.buyerId == request.auth.uid ||
                        request.resource.data.sellerId == request.auth.uid) &&
                       request.resource.data.status == 'pending';
      
      allow update: if isAdmin() || 
                       (isSignedIn() &&
                        (resource.data.buyerId == request.auth.uid ||
                         resource.data.sellerId == request.auth.uid) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      
      allow delete: if isAdmin();
    }
    
    // ============================================
    // CMS — Feature Toggles, System Settings
    // ============================================
    match /feature_toggles/{toggleId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // DOCUMENT UPLOADS (Firestore fallback for Storage uploads)
    // Written server-side by uploadDocumentAction — clients cannot write directly
    // ============================================
    match /_document_uploads/{uploadId} {
      // Owner can read their own uploaded documents; Admin can read all
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      // Writes only via Admin SDK (no client write allowed)
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // DISPUTES
    // ============================================
    match /disputes/{disputeId} {
      // Parties involved + admin can read
      allow read: if isSignedIn() &&
                     (resource.data.buyerId == request.auth.uid ||
                      resource.data.sellerId == request.auth.uid ||
                      isAdmin());
      
      // Disputes are only created by server actions (Admin SDK)
      allow create: if false;
      
      // Parties can update ONLY safe fields (e.g. adding a message)
      // Admin can update any field EXCEPT escalated/assignedAdminId/assignedBy
      // which are protected to admin-only write to prevent tampering
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         // Status management
                         'status', 'resolution', 'resolvedBy', 'resolvedAt',
                         // Escalation — admin-only
                         'escalated', 'escalatedAt', 'escalatedBy',
                         // Assignment — admin-only
                         'assignedAdminId', 'assignedAdminName', 'assignedBy', 'assignedAt',
                         // Generic
                         'adminNote', 'updatedAt'
                       ]);
      
      allow delete: if isAdmin();
      
      // ── Escalation Notes (subcollection) ────────────────────────────────
      // Admins create notes; parties involved can read notes on their dispute
      match /notes/{noteId} {
        allow read: if isSignedIn() &&
                       (get(/databases/$(database)/documents/disputes/$(disputeId)).data.buyerId == request.auth.uid ||
                        get(/databases/$(database)/documents/disputes/$(disputeId)).data.sellerId == request.auth.uid ||
                        isAdmin());
        
        // Only admins can add notes
        allow create: if isAdmin() &&
                         request.resource.data.keys().hasAll(['text', 'createdBy', 'createdAt']) &&
                         request.resource.data.createdBy == request.auth.uid;
        
        // Notes are immutable once written
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
    
    // ============================================
    // COOPERATIVES (top-level collection)
    // ============================================
    match /cooperatives/{cooperativeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // COOPERATIVE LOANS & FIXED SAVINGS
    // ============================================
    match /cooperative_loans/{loanId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /cooperative_fixed_savings/{savingsId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /cooperative_loan_products/{productId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /cooperative_withdrawals/{withdrawalId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /withdrawal_requests/{requestId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // LOANS (standalone collection)
    // ============================================
    match /loans/{loanId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /loan_products/{productId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /loan_repayments/{repaymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;  // Server-side only
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /loan_payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;  // Server-side only
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // EXPORT MODULE (additional collections)
    // ============================================
    match /exportWindows/{windowId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /export_slots/{slotId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /exportInvestments/{investmentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /export_bookings/{bookingId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /investorPortfolios/{portfolioId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;  // Server-side only
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // ACADEMY MODULE (additional collections)
    // ============================================
    match /academy_applications/{applicationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /academy_quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /academy_live_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /course_progress/{progressId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /course_certificates/{certificateId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /quiz_attempts/{attemptId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;  // Immutable
      allow delete: if isAdmin();
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /lesson_video_progress/{progressId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // ============================================
    // MARKETPLACE (additional collections)
    // ============================================
    match /marketplaceOrders/{orderId} {
      allow read: if isSignedIn() &&
                     (resource.data.buyerId == request.auth.uid ||
                      request.auth.uid in resource.data.sellerIds ||
                      isAdmin());
      allow create: if isSignedIn() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isOwner(resource.data.sellerId) || isAdmin();
      allow delete: if isOwner(resource.data.sellerId) || isAdmin();
    }

    match /product_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /product_images/{imageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /shopping_carts/{cartId} {
      allow read: if isOwner(cartId);
      allow create: if isSignedIn() && cartId == request.auth.uid;
      allow update: if isOwner(cartId);
      allow delete: if isOwner(cartId);
    }

    match /orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /seller_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /processedPayments/{paymentId} {
      allow read: if isAdmin();
      allow create: if false;  // Server-side only
      allow update: if false;
      allow delete: if false;
    }

    match /failedPayments/{paymentId} {
      allow read: if isAdmin();
      allow create: if false;  // Server-side only (Paystack webhook)
      allow update: if false;
      allow delete: if false;
    }

    match /paymentInstructions/{instructionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // FARM NATION (additional collections)
    // ============================================
    match /farmNationProperties/{propertyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /farm_nation_transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;  // Server-side only
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /propertyPurchases/{purchaseId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;  // Server-side only
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /land_inquiries/{inquiryId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /land_verifications/{verificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // WAVE (additional collections)
    // ============================================
    match /wave_resource_access/{accessId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /wave_briefing_registrations/{registrationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /wave_training_sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // VENDOR MODULE
    // ============================================
    match /vendor_settings/{settingId} {
      allow read: if isOwner(settingId) || isAdmin();
      allow create: if isSignedIn() && settingId == request.auth.uid;
      allow update: if isOwner(settingId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /vendor_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /vendor_orders/{orderId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /vendor_products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isOwner(resource.data.sellerId) || isAdmin();
      allow delete: if isOwner(resource.data.sellerId) || isAdmin();
    }

    match /vendor_profiles/{profileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && profileId == request.auth.uid;
      allow update: if isOwner(profileId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // WALLET & PAYMENTS
    // ============================================
    match /wallets/{walletId} {
      allow read: if isOwner(walletId) || isAdmin();
      allow create: if isSignedIn() && walletId == request.auth.uid;
      allow update: if false;  // Server-side only (financial)
      allow delete: if false;
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;  // Server-side only
      allow update: if false;
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;  // Server-side only
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;  // Server-side only
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ============================================
    // VILLAGE MARKET & FLASH SALES
    // ============================================
    match /village_market_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /flash_sale_products/{productId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // AI CHAT
    // ============================================
    match /ai_chat_history/{chatId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ============================================
    // ADMIN & SERVER-ONLY COLLECTIONS
    // These are written exclusively via Admin SDK (server actions)
    // Client access is denied or admin-only
    // ============================================
    match /admin_users/{userId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /analytics/{docId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /idempotency_keys/{keyId} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /impersonation_tokens/{tokenId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /email_queue/{emailId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /email_history/{emailId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /bounced_emails/{emailId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /broadcast_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /whatsapp_invites/{inviteId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /password_resets/{resetId} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ============================================
    // USER DATA COLLECTIONS
    // ============================================
    match /user_certificates/{certId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /user_activity_logs/{logId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if false;  // Server-side only
      allow update: if false;
      allow delete: if false;
    }

    // ============================================
    // ESCROW MESSAGES
    // ============================================
    match /escrow_messages/{messageId} {
      allow read: if isSignedIn() &&
                     (resource.data.buyerId == request.auth.uid ||
                      resource.data.sellerId == request.auth.uid ||
                      isAdmin());
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
