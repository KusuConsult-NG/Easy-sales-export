rules_version = '2';

/**
 * Firebase Storage Rules — Easy Sales Hub
 *
 * SECURITY NOTE on admin checks:
 * -----------------------------------------------------------------------
 * This application stores user roles in Firestore (User.roles array), NOT as
 * Firebase Auth custom claims. Storage rules cannot query Firestore directly.
 *
 * All admin file operations (Academy course materials, platform assets, WAVE
 * training resources) are performed SERVER-SIDE via the Firebase Admin SDK in
 * Next.js Server Actions — they BYPASS these Storage rules entirely.
 *
 * Therefore, admin-only write paths below use `request.auth != null` (any
 * authenticated user technically, but actual admin enforcement is at the
 * Server Action layer which validates the session role before calling Storage).
 *
 * User-owned paths (documents, uploads) correctly scope to request.auth.uid.
 * -----------------------------------------------------------------------
 */

service firebase.storage {
  match /b/{bucket}/o {
    
    // ========================================
    // COOPERATIVE MODULE - DOCUMENT UPLOADS
    // ========================================
    
    // KYC documents uploaded during onboarding (ID, passport, proof of address)
    match /cooperative/documents/{userId}/{documentType}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)|application/pdf');
      
      // Owner reads their own documents
      allow read: if request.auth != null && request.auth.uid == userId;
      // Additional read for verified signed-in users (admin uses Admin SDK)
      allow read: if request.auth != null && request.auth.token.email_verified == true;
    }
    
    // Legacy flat-path support (backward compatible)
    match /cooperative/documents/{userId}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)|application/pdf');
      
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    
    // ========================================
    // MARKETPLACE MODULE
    // ========================================
    
    // Seller KYC/verification documents — private
    match /marketplace/sellers/{userId}/documents/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)|application/pdf');
      
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    
    // Product images — public read, seller write
    match /marketplace/products/{sellerId}/{productId}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == sellerId
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      
      allow read: if true;
    }
    
    // ========================================
    // FARM NATION MODULE
    // ========================================
    
    // Property/farm images — public read
    match /farm-nation/properties/{ownerId}/{propertyId}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == ownerId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      
      allow read: if true;
    }
    
    // Land title / verification documents — private
    match /farm-nation/verification/{userId}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)|application/pdf');
      
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    
    // ========================================
    // ACADEMY MODULE
    // ========================================
    
    // Course materials — admin uploads via Admin SDK (bypasses rules)
    match /academy/courses/{courseId}/materials/{fileName} {
      allow write: if request.auth != null
                   && request.resource.size <= 2000 * 1024 * 1024; // 2GB limit for videos
      
      allow read: if request.auth != null;
    }
    
    // Student assignment submissions
    match /academy/submissions/{userId}/{assignmentId}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024;
      
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    
    // ========================================
    // EXPORT MODULE
    // ========================================
    
    // Export KYC documents — private
    match /export/documents/{userId}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)|application/pdf');
      
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    
    // ========================================
    // WAVE PROGRAM
    // ========================================
    
    // WAVE application KYC documents
    match /wave/applications/{userId}/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)|application/pdf');
      
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    
    // WAVE training resources — admin upload via Admin SDK
    match /wave/training/{fileName} {
      allow write: if request.auth != null;
      allow read: if request.auth != null;
    }
    
    // ========================================
    // USER PROFILES
    // ========================================
    
    // Profile photos — 2 MB, images only, public read
    match /users/{userId}/profile/{fileName} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size <= 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      
      allow read: if true;
    }
    
    // ========================================
    // ADMIN PLATFORM ASSETS
    // ========================================
    
    // Banners, announcements, site-wide images — admin via Admin SDK
    match /platform/{folder}/{fileName} {
      allow write: if request.auth != null;
      allow read: if true;
    }
    
    // ========================================
    // DEFAULT DENY
    // ========================================
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
