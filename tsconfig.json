{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@easy-sales/types": [
        "src/types/index.ts"
      ],
      "@easy-sales/types/*": [
        "src/types/index.ts"
      ],
      "@easy-sales/academy": [
        "packages/academy/src/index.ts"
      ],
      "@easy-sales/academy/*": [
        "packages/academy/src/*"
      ],
      "@easy-sales/auth": [
        "packages/auth/src/index.ts"
      ],
      "@easy-sales/auth/*": [
        "packages/auth/src/*"
      ],
      "@easy-sales/config": [
        "packages/config/src/index.ts"
      ],
      "@easy-sales/config/*": [
        "packages/config/src/*"
      ],
      "@easy-sales/cooperative": [
        "packages/cooperative/src/index.ts"
      ],
      "@easy-sales/cooperative/*": [
        "packages/cooperative/src/*"
      ],
      "@easy-sales/export": [
        "packages/export/src/index.ts"
      ],
      "@easy-sales/export/*": [
        "packages/export/src/*"
      ],
      "@easy-sales/farm-nation": [
        "packages/farm-nation/src/index.ts"
      ],
      "@easy-sales/farm-nation/*": [
        "packages/farm-nation/src/*"
      ],
      "@easy-sales/marketplace": [
        "packages/marketplace/src/index.ts"
      ],
      "@easy-sales/marketplace/*": [
        "packages/marketplace/src/*"
      ],
      "@easy-sales/services": [
        "packages/services/src/index.ts"
      ],
      "@easy-sales/services/*": [
        "packages/services/src/*"
      ],
      "@easy-sales/ui": [
        "packages/ui/src/index.ts"
      ],
      "@easy-sales/ui/*": [
        "packages/ui/src/*"
      ],
      "@easy-sales/wave": [
        "packages/wave/src/index.ts"
      ],
      "@easy-sales/wave/*": [
        "packages/wave/src/*"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "tests",
    "__tests__",
    "e2e",
    "test-*.ts",
    "functions",
    "scratch"
  ]
}
